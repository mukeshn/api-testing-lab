{
  "name": "api-testing-lab",
  "version": "1.0.0",
  "private": true,
  "description": "API testing techniques: RestAssured (Java) and Playwright/TypeScript across REST, OData, Salesforce and GraphQL",
  "author": "Mukesh Ningadali",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sut": "node sut/server.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "graphql": "^17.1.0",
    "typescript": "^7.0.2"
  }
}
